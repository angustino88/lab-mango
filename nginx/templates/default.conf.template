# Used when the backend runs without the router in front (profile "nginx"): nginx terminates TLS
# and proxies to Uvicorn on this host (host networking, see docker-compose.prod.yml).
# Rendered by the nginx image at start-up: ${UVICORN_PORT}, ${NGINX_HTTP_PORT} and ${NGINX_HTTPS_PORT}
# come from the backend's backend.env; nginx's own $variables are left untouched.
# Certificates: server.crt and server.key in SSL_DIR (default ssl_certifactes/), mounted at /etc/nginx/ssl.

upstream web_app {
    server 127.0.0.1:${UVICORN_PORT};
}

server {
    listen ${NGINX_HTTP_PORT};
    server_name _;
    return 301 https://$host:${NGINX_HTTPS_PORT}$request_uri;
}

server {
    listen ${NGINX_HTTPS_PORT} ssl;
    server_name _;

    ssl_certificate /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    client_max_body_size 20M;

    location /static/ {
        alias /static/;
    }

    # Block internal routing sync API from public listener (AUTH-6)
    location /internal/ {
        return 404;
    }

    location /ws/ {
        proxy_pass http://web_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port ${NGINX_HTTPS_PORT};
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_redirect off;
    }

    location / {
        proxy_pass http://web_app;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port ${NGINX_HTTPS_PORT};
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect off;
    }
}
