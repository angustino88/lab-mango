# Django
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-development-only-change-me
USE_DOCKER=False

# Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:debug@localhost:5432/labmango_local
CONN_MAX_AGE=0

# Redis and Celery
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_DEFAULT_QUEUE=labmango_backend
CELERY_TASK_DEFAULT_EXCHANGE=labmango_backend
CELERY_TASK_DEFAULT_ROUTING_KEY=labmango_backend
CELERY_BEAT_SCHEDULER=django_celery_beat.schedulers:DatabaseScheduler
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_HOST=127.0.0.1
CACHE_URL=redis://127.0.0.1:6379/1

# Local web access
# ------------------------------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:5173

# Email: print messages in the terminal during local testing
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=noreply@localhost

# LDAP and Azure AD: leave empty unless testing authentication integrations
# ------------------------------------------------------------------------------
LDAP_AUTH_URL=
LDAP_AUTH_SEARCH_BASE=
LDAP_AUTH_WHITELIST=admin,adminlab
AAD_AUDIENCE=
AAD_JWKS_URL=

# Optional Bosch proxy
# ------------------------------------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Optional integrations; add real values only in your local untracked .env
# ------------------------------------------------------------------------------
JIRA_ACCESS_TOKEN=
OTP_PA_API=
MONITORING_PA_API=
BOOKING_PA_API=
EQUIPMENT_PA_API=
BOOKING_APPROVAL_PA_API=
URS_API_URL=
URS_API_VERIFY_SSL=False

# MinIO (disabled by default for local tests)
# ------------------------------------------------------------------------------
USE_MINIO=False
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lab-mango
MINIO_USE_SSL=False
MINIO_REGION=us-east-1
MINIO_SIGNATURE_VERSION=s3v4
MINIO_QUERYSTRING_AUTH=False
MINIO_FILE_OVERWRITE=False

# Optional MQTT
# ------------------------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_PUBLISH=False
MQTT_PUB_TOPIC=equipment
MQTT_SUB_TOPIC=broker/message
