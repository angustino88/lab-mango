# Deployment topology for one backend: non-secret, committed in plaintext.
# scripts/deploy/backend.sh init <backend> copies this to .envs/.production/<backend>/backend.env.
# Every backend on the same host needs its own UVICORN_PORT, REDIS_PORT, NGINX_* and POSTGRES_PORT.

# Set by the helper from the folder name; keep them equal.
BACKEND_NAME=replace-with-backend
# Identity reported to the router; defaults to BACKEND_NAME when empty.
BACKEND_ID=

# Optional services: "nginx" when this backend runs without the router in front,
# "postgres" to run PostgreSQL in a container. Comma-separated, empty for neither.
COMPOSE_PROFILES=nginx

# Host ports (host networking: these must be free on the server)
UVICORN_PORT=9001
REDIS_PORT=6380
NGINX_HTTP_PORT=8081
NGINX_HTTPS_PORT=8443
POSTGRES_PORT=5432

# Optional overrides
# SSL_DIR=./ssl_certifactes
# POSTGRES_IMAGE=postgres:15.3-alpine
