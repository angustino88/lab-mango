# Template for one department's database settings (copied to .envs/.production/<department>/.postgres by
# scripts/deploy/backend.sh init). DATABASE_URL is read by Django and by the entrypoint.
# Point it at the external database, or, with the "postgres" profile in .backend, at
# 127.0.0.1:<POSTGRES_PORT from .backend>. POSTGRES_* initialise that container on first start.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=labmango
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-db-password

DATABASE_URL=postgresql://replace-with-db-user:replace-with-db-password@127.0.0.1:5432/labmango
CONN_MAX_AGE=0
DB_POOL_ENABLED=False
