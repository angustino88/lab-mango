# Production database. Copy to .envs/.production/.postgres and replace every replace-with-* value.
# DATABASE_URL is read by Django and by compose/production/django/entrypoint.
# Point it at the external database, or at 127.0.0.1:5432 when running the optional
# postgres service (docker compose -f docker-compose.prod.yml --profile postgres up -d).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=labmango
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-db-password

DATABASE_URL=postgresql://replace-with-db-user:replace-with-db-password@127.0.0.1:5432/labmango
CONN_MAX_AGE=0
DB_POOL_ENABLED=False
