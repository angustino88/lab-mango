# Local Docker environment (docker-compose.dev.yml). Copy to .envs/.local/.django.
# Django
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
# Configuration comes from these env files, not from the bind-mounted root .env.
DJANGO_READ_DOT_ENV_FILE=False
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-development-only-change-me
# Only the value "yes" enables the Docker debug-toolbar IP handling (config/settings/local.py).
USE_DOCKER=yes
UVICORN_PORT=8000

# Web access
# ------------------------------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# Redis and Celery (service names from docker-compose.dev.yml)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_DEFAULT_QUEUE=labmango_backend
CELERY_TASK_DEFAULT_EXCHANGE=labmango_backend
CELERY_TASK_DEFAULT_ROUTING_KEY=labmango_backend
CELERY_BEAT_SCHEDULER=django_celery_beat.schedulers:DatabaseScheduler
REDIS_URL=redis://redis:6379/1
CACHE_URL=redis://redis:6379/1
LOCAL_USE_REDIS_CACHE=True

# Email: print messages in the container log
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# Booking notifications: Teams (Power Automate workflow) and email
# ------------------------------------------------------------------------------
# Off by default. To enable: set the cutoff (UTC, events before it are never sent), the workflow
# URL, its exact host and the tenant UUID, deploy, then run
#   python manage.py provision_booking_notification_schedules --enable
# Details: core/labs/features/bench_bookings/docs/notifications.md
BOOKING_NOTIFICATIONS_ENABLED=False
BOOKING_NOTIFICATIONS_EMAIL_ENABLED=False
BOOKING_NOTIFICATIONS_TEAMS_ENABLED=False
BOOKING_NOTIFICATIONS_ENABLEMENT_CUTOFF=
BOOKING_NOTIFICATIONS_TEAMS_WORKFLOW_URL=
BOOKING_NOTIFICATIONS_TEAMS_ALLOWED_HOSTS=
BOOKING_NOTIFICATIONS_TEAMS_EXPECTED_TENANT_ID=
BOOKING_NOTIFICATIONS_QUEUE=booking_notifications
# Bench slot watches (notify when a bench frees up). Web needs only this flag; email/Teams also need the switches above.
BOOKING_SLOT_WATCH_ENABLED=False
BOOKING_SLOT_WATCH_LEAD_MINUTES=15
# Lab Mango web address for "Book now" links in slot alert emails and Teams messages.
BOOKING_SLOT_WATCH_APP_URL=

# Authentication integrations: leave empty unless testing them
# ------------------------------------------------------------------------------
LDAP_AUTH_URL=
LDAP_AUTH_SEARCH_BASE=
LDAP_AUTH_WHITELIST=admin,adminlab
# Empty values override the defaults and fail system check users.E013; set them only to test
# against another Entra app.
# AAD_AUDIENCE=
# AAD_JWKS_URL=

# Optional proxy
# ------------------------------------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis

# Optional integrations
# ------------------------------------------------------------------------------
# Power Automate workflow that sends the login OTP to Teams (local/LDAP login only;
# production is Entra SSO and does not use it)
OTP_PA_API=
URS_API_URL=
URS_API_VERIFY_SSL=False

# MinIO (disabled locally)
# ------------------------------------------------------------------------------
USE_MINIO=False
